&CONTROL
  calculation = 'scf',
  prefix = 'si_eq_ecut60',
  pseudo_dir = '/usr/share/espresso/pseudo/',
  outdir = './structure_optimization/tmp/',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 10.3326,
  nat = 2,
  ntyp = 1,
  ecutwfc = 60,
  ecutrho = 240,
/
&ELECTRONS
  conv_thr = 1.0d-8,
/
ATOMIC_SPECIES
Si 28.0855 Si.pbe-nl-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS alat
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25

K_POINTS automatic
16 16 16 0 0 0
